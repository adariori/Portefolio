# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EmailJS: powers the contact form (src/components/ContactForm.tsx) so it sends
# a real email without a backend. Free tier: 200 emails/month, no card needed.
# Get these from https://dashboard.emailjs.com after creating an account,
# connecting an email service, and creating a template with {{name}}, {{email}},
# {{message}} variables. Must be prefixed with VITE_ to be exposed to the client.
VITE_EMAILJS_SERVICE_ID="MY_EMAILJS_SERVICE_ID"
VITE_EMAILJS_TEMPLATE_ID="MY_EMAILJS_TEMPLATE_ID"
VITE_EMAILJS_PUBLIC_KEY="MY_EMAILJS_PUBLIC_KEY"
